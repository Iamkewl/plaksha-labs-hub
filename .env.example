# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (un-pooled) connection string — used by Prisma for migrations on Neon
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_DEV_BYPASS="false"
NEXT_PUBLIC_AUTH_DEV_BYPASS="false"
# Set both to "true" to enable email+password login (for alpha testing without Microsoft SSO)
AUTH_CREDENTIALS_ENABLED="false"
NEXT_PUBLIC_AUTH_CREDENTIALS_ENABLED="false"

# Microsoft Entra ID (Azure AD) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID="your-azure-app-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-azure-app-client-secret"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="your-azure-tenant-id"

# Transactional Email (Sprint 6)
# Supported values: disabled | resend | smtp
EMAIL_PROVIDER="disabled"
EMAIL_FROM="Makerspace Hub <noreply@example.com>"
RESEND_API_KEY="re_..."

# Rate Limiting (optional Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
